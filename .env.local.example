# Supabase Dashboard → Project Settings → API からコピー
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# サイトのベースURL（認証メールのリダイレクト先 兼 SEO 基盤の絶対URL生成に使用）
# sitemap / robots / OGP / RSS / JSON-LD で参照。本番では Vercel の URL に変更する
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Spotify Developer Dashboard → https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id
SPOTIFY_CLIENT_SECRET=your_client_secret

# Supabase 同期スクリプト用（Dashboard → Settings → API → service_role）
# ⚠️ 絶対に GitHub にコミットしない
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Vercel Cron 認証（ランダムな長い文字列。Vercel の Environment Variables にも同じ値を設定）
CRON_SECRET=your_random_secret_here

# （任意）Vercel Cron で 1 回あたり同期するアーティスト数
# SPOTIFY_SYNC_BATCH_SIZE=5
